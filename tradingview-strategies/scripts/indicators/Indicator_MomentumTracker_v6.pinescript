//@version=6
indicator("Momentum Tracker", shorttitle="MT", overlay=false)

// =============================================================================
// MOMENTUM TRACKER - Advanced Momentum Oscillator
// =============================================================================
// This protected script implements a proprietary triple-layer exponential
// smoothing algorithm to measure market momentum. The indicator provides
// clear visual signals through dynamic color changes.
//
// KEY FEATURES:
// • Oscillates between 0-100 with dynamic color coding
// • Blue: Rising momentum (bullish)
// • Red: Falling momentum (bearish)  
// • Yellow: Neutral/consolidating momentum
// • Reference levels at 90 (overbought), 50 (midline), 10 (oversold)
//
// TRADING APPLICATIONS:
// • Trend identification through color changes
// • Overbought/oversold conditions at extreme readings
// • Divergence analysis between price and indicator
// • Multi-timeframe momentum confirmation
//
// IMPORTANT: This is a technical analysis tool. Always use proper risk
// management and combine with other analysis methods. Past performance
// does not guarantee future results.
// =============================================================================

// Hardcoded parameters (protected values)
len = 7
filter = 0.0

// Initialize variables
var float v8 = 0.0
var float v16 = 0.0
var float v0 = 0.0
var float v80 = 0.0
var float v88 = 0.0
var float v96 = 0.0
var float v104 = 0.0
var float v112 = 0.0
var float v120 = 0.0
var float v128 = 0.0
var float v208 = 0.0
var float v136 = 0.0
var float v152 = 0.0
var float v160 = 0.0
var float v168 = 0.0
var float v176 = 0.0
var float v184 = 0.0
var float v192 = 0.0
var float v200 = 0.0

// Declare calculation variables
var float v32 = 0.0
var float v40 = 0.0
var float v48 = 0.0
var float v56 = 0.0
var float v64 = 0.0
var float v72 = 0.0
var float v144 = 0.0

// Calculate typical price
tp = (high + low + close) / 3.0

// Variable to store the final indicator value
float v24 = 50.0

// Main calculation
if v8 == 0.0
    v8 := 1.0
    v16 := 0.0
    v0 := len - 1 >= 5 ? len - 1.0 : 5.0
    v80 := 100.0 * tp
    v96 := 3.0 / (len + 2.0)
    v104 := 1.0 - v96
else
    if v0 <= v8
        v8 := v0 + 1.0
    else
        v8 := v8 + 1.0
    
    v88 := v80
    v80 := 100.0 * tp
    
    // Price change
    v32 := v80 - v88
    
    // First smoothing layer
    v112 := v104 * v112 + v96 * v32
    v120 := v96 * v112 + v104 * v120
    v40 := 1.5 * v112 - v120 / 2.0
    
    // Second smoothing layer
    v128 := v104 * v128 + v96 * v40
    v208 := v96 * v128 + v104 * v208
    v48 := 1.5 * v128 - v208 / 2.0
    
    // Third smoothing layer
    v136 := v104 * v136 + v96 * v48
    v152 := v96 * v136 + v104 * v152
    v56 := 1.5 * v136 - v152 / 2.0
    
    // Absolute value smoothing - first layer
    v160 := v104 * v160 + v96 * math.abs(v32)
    v168 := v96 * v160 + v104 * v168
    v64 := 1.5 * v160 - v168 / 2.0
    
    // Absolute value smoothing - second layer
    v176 := v104 * v176 + v96 * v64
    v184 := v96 * v176 + v104 * v184
    v144 := 1.5 * v176 - v184 / 2.0
    
    // Absolute value smoothing - third layer
    v192 := v104 * v192 + v96 * v144
    v200 := v96 * v192 + v104 * v200
    v72 := 1.5 * v192 - v200 / 2.0
    
    if v0 >= v8 and v80 != v88
        v16 := 1.0
    
    if v0 == v8 and v16 == 0.0
        v8 := 0.0

// Calculate final indicator value
if v0 < v8 and v72 > 0.0000000001
    v24 := 50.0 * (v56 / v72 + 1.0)
    if v24 > 100.0
        v24 := 100.0
    if v24 < 0.0
        v24 := 0.0
else
    v24 := 50.0

// ===== BREAKTHROUGH MOMENTUM ZONE DETECTION =====
// FEATURE: Fast exit scalping style - resets on every direction change
// This creates quick profit-taking signals on momentum reversals
var float equilibriumLevel = na
var float thresholdRange = 2.0  // Adjustable sensitivity

prevV24 = nz(v24[1], 50.0)

// Detect significant momentum direction changes
currentChange = v24 - prevV24
previousChange = prevV24 - nz(v24[2], prevV24)

// Momentum direction change (from positive to negative or vice versa)
trendChanged = (currentChange > 0 and previousChange <= 0) or (currentChange < 0 and previousChange >= 0)

// Update equilibrium level when trend changes (SCALPING FEATURE)
if trendChanged or na(equilibriumLevel)
    equilibriumLevel := v24

// Determine if we're within the yellow equilibrium zone
inYellowZone = math.abs(v24 - equilibriumLevel) <= thresholdRange

// Apply the breakthrough logic that matches MT4 exactly
color lineColor = color.yellow

if inYellowZone
    // Within threshold of equilibrium - show YELLOW (neutral/consolidating)
    lineColor := color.yellow
else if v24 > equilibriumLevel + thresholdRange
    // Broke above equilibrium threshold - show BLUE (bullish momentum)
    lineColor := #1E90FF  // DodgerBlue
else if v24 < equilibriumLevel - thresholdRange
    // Broke below equilibrium threshold - show RED (bearish momentum)
    lineColor := color.red
else
    // Default fallback to yellow
    lineColor := color.yellow

// Plot single line with enhanced momentum-based color changes
plot(v24, title="Momentum Tracker", color=lineColor, linewidth=2)

// Debug plot (optional - can be commented out)
// plot(equilibriumLevel, title="Equilibrium Level", color=color.gray, linewidth=1, display=display.none)

// Plot reference levels
hline(90, "Overbought", color=color.gray, linestyle=hline.style_dashed)
hline(50, "Midline", color=color.gray, linestyle=hline.style_dashed)
hline(10, "Oversold", color=color.gray, linestyle=hline.style_dashed)

// Fill background zones
h1 = hline(100, display=display.none)
h2 = hline(90, display=display.none)
h3 = hline(10, display=display.none)
h4 = hline(0, display=display.none)

fill(h1, h2, color=color.new(color.red, 90), title="Overbought Zone")
fill(h3, h4, color=color.new(color.blue, 90), title="Oversold Zone")
