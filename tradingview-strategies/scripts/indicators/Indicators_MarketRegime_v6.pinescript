//@version=5
indicator("Market Regime Detection", overlay=true)

//=== USER INPUTS =============================================================================
// Trend Parameters
trend_ma_length = input.int(50, title="Trend MA Length", minval=10, maxval=200)
trend_threshold = input.float(1.5, title="Trend Strength Threshold", minval=0.5, maxval=5.0, step=0.1)

// Volatility Parameters
atr_length = input.int(14, title="ATR Length", minval=5, maxval=50)
volatility_threshold = input.float(1.5, title="Volatility Threshold", minval=0.5, maxval=5.0, step=0.1)

// Display Options
show_background = input.bool(true, title="Show Regime Background")
show_labels = input.bool(true, title="Show Regime Labels")

//=== CALCULATIONS ==========================================================================
// Trend Detection
trend_ma = ta.ema(close, trend_ma_length)
trend_strength = (close - trend_ma) / trend_ma * 100

// Volatility Detection
atr_value = ta.atr(atr_length)
average_range = ta.sma(high - low, atr_length * 3)
volatility_ratio = atr_value / average_range

// Regime Classification
is_uptrend = trend_strength > trend_threshold
is_downtrend = trend_strength < -trend_threshold
is_sideways = not is_uptrend and not is_downtrend

is_high_volatility = volatility_ratio > volatility_threshold
is_normal_volatility = not is_high_volatility

// Combined Regime States
regime = is_uptrend and is_normal_volatility ? "BULLISH_NORMAL" :
         is_uptrend and is_high_volatility ? "BULLISH_VOLATILE" :
         is_downtrend and is_normal_volatility ? "BEARISH_NORMAL" : 
         is_downtrend and is_high_volatility ? "BEARISH_VOLATILE" :
         is_normal_volatility ? "SIDEWAYS_NORMAL" : "SIDEWAYS_VOLATILE"

//=== VISUALIZATION ==========================================================================
// Background colors for different regimes
bgcolor(show_background ? regime == "BULLISH_NORMAL" ? color.new(color.green, 95) : 
                         regime == "BULLISH_VOLATILE" ? color.new(color.lime, 90) :
                         regime == "BEARISH_NORMAL" ? color.new(color.red, 95) :
                         regime == "BEARISH_VOLATILE" ? color.new(color.orange, 90) :
                         regime == "SIDEWAYS_NORMAL" ? color.new(color.gray, 95) : 
                         color.new(color.maroon, 90) : na, title="Regime Background")

// Trend line
plot(trend_ma, color=color.new(color.blue, 50), linewidth=2, title="Trend MA")

// Volatility indicator
plotshape(volatility_ratio > volatility_threshold ? high : na, shape.triangledown, 
          location.abovebar, color=color.new(color.orange, 0), size=size.tiny, title="High Volatility")

// Regime labels
if show_labels and barstate.isconfirmed
    if regime != regime[1]  // Regime changed
        label_text = "\n" + regime + "\nVol: " + str.tostring(volatility_ratio, "#.##") + 
                     "\nTrend: " + str.tostring(trend_strength, "#.##") + "%"
        
        label.new(bar_index, high, label_text, style=label.style_label_down,
                 color=color.new(color.yellow, 20), textcolor=color.black, 
                 size=size.small, title="Regime Label")

// Plot trend strength
plot(trend_strength, color=color.new(color.purple, 0), linewidth=1, title="Trend Strength")
hline(trend_threshold, "Trend Up Threshold", color=color.new(color.green, 0), linestyle=hline.style_dashed)
hline(-trend_threshold, "Trend Down Threshold", color=color.red, linestyle=hline.style_dashed)
hline(0, "Neutral", color=color.gray, linestyle=hline.style_dotted)

// Trading suggestions based on regime
trading_bias = regime == "BULLISH_NORMAL" or regime == "BULLISH_VOLATILE" ? "LIKELY UPTREND" :
                regime == "BEARISH_NORMAL" or regime == "BEARISH_VOLATILE" ? "LIKELY DOWNTREND" : "LIKELY SIDEWAYS"

plotshape(barstate.islast and trading_bias != trading_bias[1] ? close : na, shape.labelup,
          location.belowbar, color=color.new(color.blue, 0), style=label.style_label_up,
          size=size.normal, title="Trading Bias")

//=== ALERT CONDITIONS =======================================================================
alertcondition(regime != regime[1], title="Market Regime Changed", 
               message="Market regime changed to: " + regime + " on {{ticker}}")

alertcondition(regime == "BULLISH_NORMAL", title="Bullish Normal Market", 
               message="Bullish normal market conditions detected on {{ticker}}")

alertcondition(regime == "BEARISH_NORMAL", title="Bearish Normal Market", 
               message="Bearish normal market conditions detected on {{ticker}}")

alertcondition(regime == "SIDEWAYS_VOLATILE", title="High Volatility Sideways", 
               message="High volatility sideways market on {{ticker}}")

//=== STRATEGY UTILITY FUNCTIONS ===============================================================
// Export functions for strategy scripts
export bullMarket(bool isBull) =>
    regime == "BULLISH_NORMAL" or regime == "BULLISH_VOLATILE"

export bearMarket(bool isBear) =>
    regime == "BEARISH_NORMAL" or regime == "BEARISH_VOLATILE"

export sidewaysMarket(bool isSideways) =>
    regime == "SIDEWAYS_NORMAL" or regime == "SIDEWAYS_VOLATILE"

export highVolatility(bool isHighVol) =>
    is_high_volatility

export trendDirection(int direction) =>
    is_uptrend ? 1 : is_downtrend ? -1 : 0
