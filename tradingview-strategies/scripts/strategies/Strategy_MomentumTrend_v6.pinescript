//@version=6
strategy("Momentum Trend Strategy", overlay=true, 
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=10,
         commission_value=0.1,
         slippage=2)

//=== USER INPUTS =============================================================================
// Momentum Tracker Parameters
momentum_threshold = input.float(2.0, title="Momentum Equilibrium Threshold", minval=0.5, maxval=5.0, step=0.1)
higher_tf_momentum = input.string("4H", title="Higher Timeframe for Trend Confirmation")
trend_length = input.int(20, title="Trend MA Length", minval=5, maxval=100)

// Risk Management Parameters
risk_percent = input.float(1.0, title="Risk % Per Trade", minval=0.1, maxval=5.0, step=0.1) / 100
atr_multiplier = input.float(2.0, title="ATR Stop Loss Multiplier", minval=1.0, maxval=5.0, step=0.1)
atr_length = input.int(14, title="ATR Length", minval=5, maxval=50)

// Strategy Parameters
use_trend_filter = input.bool(true, title="Use Trend Filter")
use_take_profit = input.bool(true, title="Use Take Profit")
take_profit_ratio = input.float(2.0, title="Take Profit Ratio", minval=1.0, maxval=5.0, step=0.1)

//=== MOMENTUM TRACKER CALCULATION =========================================================

// Initialize variables
var float v8 = 0.0
var float v16 = 0.0
var float v0 = 0.0
var float v80 = 0.0
var float v88 = 0.0
var float v96 = 0.0
var float v104 = 0.0
var float v112 = 0.0
var float v120 = 0.0
var float v128 = 0.0
var float v208 = 0.0
var float v136 = 0.0
var float v152 = 0.0
var float v160 = 0.0
var float v168 = 0.0
var float v176 = 0.0
var float v184 = 0.0
var float v192 = 0.0
var float v200 = 0.0

// Declare calculation variables
var float v32 = 0.0
var float v40 = 0.0
var float v48 = 0.0
var float v56 = 0.0
var float v64 = 0.0
var float v72 = 0.0
var float v144 = 0.0

// Calculate typical price
tp = (high + low + close) / 3.0

// Variable to store the final indicator value
float v24 = 50.0

len = 7  // Hardcoded length as per original MT4

// Main calculation
if v8 == 0.0
    v8 := 1.0
    v16 := 0.0
    v0 := len - 1 >= 5 ? len - 1.0 : 5.0
    v80 := 100.0 * tp
    v96 := 3.0 / (len + 2.0)
    v104 := 1.0 - v96
else
    if v0 <= v8
        v8 := v0 + 1.0
    else
        v8 := v8 + 1.0
    
    v88 := v80
    v80 := 100.0 * tp
    
    // Price change
    v32 := v80 - v88
    
    // First smoothing layer
    v112 := v104 * v112 + v96 * v32
    v120 := v96 * v112 + v104 * v120
    v40 := 1.5 * v112 - v120 / 2.0
    
    // Second smoothing layer
    v128 := v104 * v128 + v96 * v40
    v208 := v96 * v128 + v104 * v208
    v48 := 1.5 * v128 - v208 / 2.0
    
    // Third smoothing layer
    v136 := v104 * v136 + v96 * v48
    v152 := v96 * v136 + v104 * v152
    v56 := 1.5 * v136 - v152 / 2.0
    
    // Absolute value smoothing - first layer
    v160 := v104 * v160 + v96 * math.abs(v32)
    v168 := v96 * v160 + v104 * v168
    v64 := 1.5 * v160 - v168 / 2.0
    
    // Absolute value smoothing - second layer
    v176 := v104 * v176 + v96 * v64
    v184 := v96 * v176 + v104 * v184
    v144 := 1.5 * v176 - v184 / 2.0
    
    // Absolute value smoothing - third layer
    v192 := v104 * v192 + v96 * v144
    v200 := v96 * v192 + v104 * v200
    v72 := 1.5 * v192 - v200 / 2.0
    
    if v0 >= v8 and v80 != v88
        v16 := 1.0
    
    if v0 == v8 and v16 == 0.0
        v8 := 0.0

// Calculate final indicator value
if v0 < v8 and v72 > 0.0000000001
    v24 := 50.0 * (v56 / v72 + 1.0)
    if v24 > 100.0
        v24 := 100.0
    if v24 < 0.0
        v24 := 0.0
else
    v24 := 50.0

// === MOMENTUM DIRECTION ANALYSIS ======================================================

prevV24 = nz(v24[1], 50.0)
currentChange = v24 - prevV24
previousChange = prevV24 - nz(v24[2], prevV24)

// Momentum direction change detection
trendChanged = (currentChange > 0 and previousChange <= 0) or (currentChange < 0 and previousChange >= 0)

var float equilibriumLevel = na
if trendChanged or na(equilibriumLevel)
    equilibriumLevel := v24

inYellowZone = math.abs(v24 - equilibriumLevel) <= momentum_threshold
momentum_bullish = v24 > equilibriumLevel + momentum_threshold
momentum_bearish = v24 < equilibriumLevel - momentum_threshold

// === TREND FILTER ========================================================================
higher_tf_momentum_value = request.security(syminfo.tickerid, higher_tf_momentum, v24, lookahead=barmerge.lookahead_on)
higher_tf_bullish = higher_tf_momentum_value > nz(higher_tf_momentum_value[1], 50) + momentum_threshold
higher_tf_bearish = higher_tf_momentum_value < nz(higher_tf_momentum_value[1], 50) - momentum_threshold

trend_ma = ta.ema(close, trend_length)
trend_filter_bullish = close > trend_ma
trend_filter_bearish = close < trend_ma

// === STRATEGY LOGIC ====================================================================
// Long entry conditions
long_momentum = momentum_bullish and (not use_trend_filter or trend_filter_bullish)
long_trend_confirm = not use_trend_filter or higher_tf_bullish
long_condition = long_momentum and long_trend_confirm

// Short entry conditions  
short_momentum = momentum_bearish and (not use_trend_filter or trend_filter_bearish)
short_trend_confirm = not use_trend_filter or higher_tf_bearish
short_condition = short_momentum and short_trend_confirm

// Exit conditions
exit_long = momentum_bearish or (use_trend_filter and not trend_filter_bullish)
exit_short = momentum_bullish or (use_trend_filter and not trend_filter_bearish)

//=== RISK MANAGEMENT ===================================================================
// Calculate position size based on risk percentage
calculatePositionSize() =>
    current_equity = strategy.netprofit + strategy.initial_capital
    risk_amount = current_equity * risk_percent
    stop_distance = ta.atr(atr_length) * atr_multiplier
    position_size = risk_amount / stop_distance
    position_size

// === STRATEGY EXECUTION ===============================================================
// Long trades
if long_condition and strategy.opentrades == 0
    position_size_value = calculatePositionSize()
    stop_loss_price = close - (ta.atr(atr_length) * atr_multiplier)
    take_profit_price = use_take_profit ? close + (ta.atr(atr_length) * atr_multiplier * take_profit_ratio) : na
    
    strategy.entry("Long", strategy.long, qty=position_size_value)
    strategy.exit("Exit Long", from_entry="Long", stop=stop_loss_price, limit=take_profit_price)

// Short trades
if short_condition and strategy.opentrades == 0
    position_size_value = calculatePositionSize()
    stop_loss_price = close + (ta.atr(atr_length) * atr_multiplier)
    take_profit_price = use_take_profit ? close - (ta.atr(atr_length) * atr_multiplier * take_profit_ratio) : na
    
    strategy.entry("Short", strategy.short, qty=position_size_value)
    strategy.exit("Exit Short", from_entry="Short", stop=stop_loss_price, limit=take_profit_price)

// Exit conditions
if exit_long
    strategy.close("Long", comment="Exit long - momentum changed")

if exit_short
    strategy.close("Short", comment="Exit short - momentum changed")

//=== VISUALIZATION =======================================================================
// Plot trend MA
plot(trend_ma, color=color.new(color.gray, 50), linewidth=2, title="Trend MA")

// Plot momentum direction
momentum_color = momentum_bullish ? #1E90FF : momentum_bearish ? color.red : color.yellow
plotshape(momentum_bullish or momentum_bearish ? close : na, shape.circle, 
          location.abovebar, color=momentum_color, size=size.tiny, title="Momentum Signal")

// Plot entry signals
plotshape(long_condition ? low : na, shape.labelup, location.belowbar, 
          color=color.new(color.green, 0), style=label.circle, size=size.small, title="Long Entry")
plotshape(short_condition ? high : na, shape.labeldown, location.abovebar, 
          color=color.new(color.red, 0), style=label.circle, size=size.small, title="Short Entry")

// Display momentum value and equilibrium
var label momentum_label = na
if barstate.islast
    momentum_text = "Momentum: " + str.tostring(v24, "#.##") + "\n" +
                   "Equilibrium: " + str.tostring(equilibriumLevel, "#.##") + "\n" +
                   "Direction: " + (momentum_bullish ? "BULLISH" : momentum_bearish ? "BEARISH" : "NEUTRAL") + "\n" +
                   "Higher TF: " + str.tostring(higher_tf_momentum_value, "#.##")
    
    if na(momentum_label)
        momentum_label := label.new(bar_index, high, momentum_text, style=label.style_label_down, 
                                   color=color.new(color.white, 80), textcolor=color.black, size=size.small)
    else
        label.set_text(momentum_label, momentum_text)
        label.set_y(momentum_label, high)

//=== ALERT CONDITIONS ===================================================================
alertcondition(long_condition, title="Long Entry Signal", 
               message="Long entry signal: {{ticker}} at {{close}} - Momentum: " + str.tostring(v24, "#.##"))

alertcondition(short_condition, title="Short Entry Signal", 
               message="Short entry signal: {{ticker}} at {{close}} - Momentum: " + str.tostring(v24, "#.##"))

alertcondition(exit_long or exit_short, title="Exit Signal", 
               message="Exit signal: {{ticker}} - Momentum direction changed")

// Performance tracking
eq_plot = plot(strategy.netprofit, color=color.new(color.purple, 100), linewidth=1, title="Equity Curve", display=display.data_window)
hline(0, "Breakeven", color=color.gray, linestyle=hline.style_dashed, display=display.data_window)
